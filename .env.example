# Copy to .env and fill in real values. Never commit real values.

# Meta / WhatsApp Cloud API
META_APP_ID=<app id>
META_WABA_ID=<whatsapp business account id>
META_PHONE_NUMBER_ID=<sender phone number id>
META_API_VERSION=<graph api version, e.g. v25.0>
META_ACCESS_TOKEN=<system user token - set outside git>
META_APP_SECRET=<app secret - set outside git>
# Random string you also enter in the Meta dashboard webhook settings
WEBHOOK_VERIFY_TOKEN=<random verify token - set outside git>
# Receiving sender -> agency routing: phone_number_id=agency_uuid[,phone_number_id=agency_uuid]
WEBHOOK_SENDER_AGENCIES=<phone number id>=<agency uuid from python -m app.provision_agency>

# Web server port (hosts may set this)
PORT=8000

# Worker threads, each with its own database connection (default 2)
WORKER_CONCURRENCY=2

# Postgres
DATABASE_URL=<postgresql://user:password@host:5432/dbname>

# S3-compatible bucket. On AWS EC2, credentials come from the instance role;
# elsewhere set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
S3_BUCKET=<bucket name>
S3_REGION=<e.g. us-east-1>
# Only for non-AWS S3-compatible storage; leave empty on AWS.
S3_ENDPOINT_URL=
# Public https base of the bucket's card/ objects (carousel headers), e.g. a CDN.
# Leave empty on AWS: https://<bucket>.s3.<region>.amazonaws.com is used.
MEDIA_PUBLIC_BASE_URL=

# Contact address shown on the public /privacy page (required by Meta to publish the app)
PRIVACY_CONTACT_EMAIL=

# Public hostname Caddy serves over HTTPS (deploy/compose.yml), e.g. 1-2-3-4.sslip.io
SITE_ADDRESS=

# LLM + speech-to-text (demo uses free tiers; never commit real keys)
GEMINI_API_KEY=<google ai studio api key - set outside git>

# AI turn engine (Task 6.1): "stub" (default) or "gemini". With "gemini" the key and
# both model IDs are required (and migration 013 applied), or the worker exits
# with code 78 and a logged reason, claiming no job. Migration 014 is required with any
# AI_PROVIDER (the worker checks it at start the same way). Verify both IDs (and
# free-tier limits) in AI Studio before activating. Owner decision 2026-10-11 (pinned,
# no aliases): gemini-3.5-flash-lite (primary), gemini-3.6-flash (failover).
AI_PROVIDER=stub
LLM_PRIMARY_MODEL=
LLM_FAILOVER_MODEL=
# Thinking level per call: minimal / low / medium / high; empty = low (default);
# "off" leaves the field out of the request (kill switch if a model rejects it).
LLM_THINKING_LEVEL=

# Restrict this key to Speech to Text only
ELEVENLABS_API_KEY=<elevenlabs api key - set outside git>

# Speech (Task 6.3): "off" (default) or "elevenlabs" (Scribe v2; needs the key above
# and S3_BUCKET, and migration 013). STT_FALLBACK: "gemini" (audio transcription with
# LLM_PRIMARY_MODEL; needs GEMINI_API_KEY) or "off"; empty = gemini when the Gemini
# key and LLM_PRIMARY_MODEL are set. Unusable settings stop the worker with code 78.
# Free tiers may train on data: team / volunteer phones only. Design: docs/SPEECH.md.
STT_PROVIDER=off
STT_FALLBACK=

# Task 11.1 handoff. Minutes a broker has to accept a lead before the admin gets it too
# (default 15). The broker alert template used when the broker's 24 h window is closed:
# its name, language code (exactly as in WhatsApp Manager) and the fields that fill its
# {{1}}, {{2}}, ... in order (lead, reason, customer, wants, property; default
# property,lead for the submitted new_lead_alert).
HANDOFF_ACCEPT_MINUTES=
LEAD_ALERT_TEMPLATE=
LEAD_ALERT_LANGUAGE=
LEAD_ALERT_PARAMS=
